<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="alu_fifo---operation-flowchart-(one-clock-cycle)" name="alu_fifo - operation flowchart (one clock cycle)">
<mxGraphModel dx="1150" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="900" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="rst" value="&lt;b&gt;Reset: rst_n low&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;pointers cleared: both FIFOs empty&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="55" width="300" height="55" as="geometry"/></mxCell>
<mxCell id="dpush" value="&lt;b&gt;in_valid &amp;amp;&amp;amp; !in_full ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;(in_ready = !in_full)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="push" value="&lt;b&gt;Push {op, a, b} into u_in_fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;write pointer advances&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="155" width="330" height="52" as="geometry"/></mxCell>
<mxCell id="dx" value="&lt;b&gt;xfer ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;!in_empty &amp;amp;&amp;amp; !out_full&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="255" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="hold" value="&lt;b&gt;Hold: nothing moves&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;in FIFO empty or out FIFO full&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="alu" value="&lt;b&gt;ALU computes y, c, v from the head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;op selects ADD..SLTU; flags N,Z,C,V derived&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="mv" value="&lt;b&gt;Same cycle: pop u_in_fifo, push {flags, y}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;u_out_fifo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="300" height="62" as="geometry"/></mxCell>
<mxCell id="dout" value="&lt;b&gt;out_valid &amp;amp;&amp;amp; out_ready ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;(out_valid = !out_empty)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="565" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="pop" value="&lt;b&gt;Pop {flags, y}: consumer takes the result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;read pointer advances&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="330" height="52" as="geometry"/></mxCell>
<mxCell id="end" value="&lt;b&gt;Next cycle&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="300" height="52" as="geometry"/></mxCell>
<mxCell id="n" value="The two FIFO decisions (push and xfer) and the pop decision are all evaluated in the same cycle; an input push and a transfer can both happen.&lt;br&gt;Back-pressure: a full output FIFO stops xfer, the input FIFO then fills, and in_ready falls - nothing is dropped or reordered.&lt;br&gt;Latency: a command pushed in cycle t is at the head of u_in_fifo in t+1 (first-word fall-through), and its result is visible in u_out_fifo in t+2." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="907.36" height="47.25" as="geometry"/></mxCell>
<mxCell id="m_rst" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rst" target="dpush" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_dpush" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dpush" target="dx" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_dpush_lbl" value="no / after push" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="533" y="228" width="104" height="19" as="geometry"/></mxCell>
<mxCell id="m_dx" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dx" target="alu" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_dx_lbl" value="yes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="571.4" y="343" width="27.2" height="19" as="geometry"/></mxCell>
<mxCell id="m_alu" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alu" target="mv" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_mv" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mv" target="dout" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_dout" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dout" target="end" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m_dout_lbl" value="no: result stays valid and stable" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="475.4" y="658" width="219.2" height="19" as="geometry"/></mxCell>
<mxCell id="p1" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dpush" target="push" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1_lbl" value="yes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="701.4" y="158.5" width="27.2" height="19" as="geometry"/></mxCell>
